{
  "$id": "https://raw.githubusercontent.com/YSCohen/rust-zmanim-cli/main/schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "zmanim config",
  "description": "The deserialized config file.",
  "type": "object",
  "properties": {
    "default_location": {
      "description": "Location name used when neither `--location` nor raw coords are given.",
      "type": [
        "string",
        "null"
      ]
    },
    "zmanim": {
      "description": "Default zman names used when none are given on the command line.",
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "#/definitions/ZmanName"
      }
    },
    "format": {
      "description": "Default output format.",
      "anyOf": [
        {
          "$ref": "#/definitions/Format"
        },
        {
          "type": "null"
        }
      ]
    },
    "precision": {
      "description": "Default display precision.",
      "anyOf": [
        {
          "$ref": "#/definitions/Precision"
        },
        {
          "type": "null"
        }
      ]
    },
    "round": {
      "description": "Default rounding mode.",
      "anyOf": [
        {
          "$ref": "#/definitions/Round"
        },
        {
          "type": "null"
        }
      ]
    },
    "time_style": {
      "description": "Default time-rendering style.",
      "anyOf": [
        {
          "$ref": "#/definitions/TimeStyle"
        },
        {
          "type": "null"
        }
      ]
    },
    "locations": {
      "description": "Saved locations, keyed by name.",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/LocationEntry"
      }
    }
  },
  "additionalProperties": false,
