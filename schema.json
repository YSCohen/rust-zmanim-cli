    "Format": {
      "description": "Output format.",
      "oneOf": [
        {
          "description": "Aligned text table (or a vertical list for a single date).",
          "type": "string",
          "const": "table"
        },
        {
          "description": "Comma-separated values.",
          "type": "string",
          "const": "csv"
        },
        {
          "description": "JSON array of per-date objects.",
          "type": "string",
          "const": "json"
        }
      ]
    },
    "Precision": {
      "description": "Display precision for human-readable output.",
      "oneOf": [
        {
          "description": "Minutes.",
          "type": "string",
          "const": "m"
        },
        {
          "description": "Seconds.",
          "type": "string",
          "const": "s"
        },
        {
          "description": "Milliseconds.",
          "type": "string",
          "const": "ms"
        }
      ]
    },
    "Round": {
      "description": "Rounding mode for human-readable output. `down`/`up` mean earlier/later.",
      "oneOf": [
        {
          "description": "Round to the nearest unit.",
          "type": "string",
          "const": "nearest"
        },
        {
          "description": "Round toward earlier times (floor).",
          "type": "string",
          "const": "down"
        },
        {
          "description": "Round toward later times (ceil).",
          "type": "string",
          "const": "up"
        }
      ]
    },
    "TimeStyle": {
      "description": "How time values are rendered.",
      "oneOf": [
        {
          "description": "Human clock times for table/csv, full-precision ISO for json.",
          "type": "string",
          "const": "auto"
        },
        {
          "description": "Human-readable clock times/durations (honors precision and round).",
          "type": "string",
          "const": "human"
        },
        {
          "description": "Full-precision ISO 8601 (RFC-3339 times, `PT..` durations).",
          "type": "string",
          "const": "iso"
        }
      ]
    },
    "LocationEntry": {
      "description": "A single saved location.",
      "type": "object",
      "properties": {
        "latitude": {
          "description": "Latitude in decimal degrees.",
          "type": "number",
          "format": "double",
          "minimum": -90.0,
          "maximum": 90.0
        },
        "longitude": {
          "description": "Longitude in decimal degrees.",
          "type": "number",
          "format": "double",
          "minimum": -180.0,
          "maximum": 180.0
        },
        "elevation": {
          "description": "Elevation in meters (default 0).",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "timezone": {
          "description": "IANA timezone name.",
          "type": "string"
        },
        "use_elevation": {
          "description": "Per-location elevation policy.",
          "anyOf": [
            {
              "$ref": "#/definitions/UseElevationArg"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "latitude",
        "longitude",
        "timezone"
      ]
    },
    "UseElevationArg": {
      "description": "Elevation policy, mirroring [`UseElevation`].",
      "oneOf": [
        {
          "description": "Never use elevation.",
          "type": "string",
          "const": "no"
        },
        {
          "description": "Use elevation only for sunrise/sunset.",
          "type": "string",
          "const": "hanetz-shkia"
        },
        {
          "description": "Use elevation for all zmanim.",
          "type": "string",
          "const": "all"
        }
      ]
    }
  }
